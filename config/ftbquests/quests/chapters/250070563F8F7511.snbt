				type: "checkmark"
			}]
			x: -6.0d
			y: -4.0d
		}
		{
			description: [
				"This quest contains some important information for your playthrough."
				""
				"This quest line is meant to guide you through the major milestones of GregTech progression."
				""
				"Playing on Peaceful is recommended, since hostile mobs bring very few benefits."
				""
				"Feel free to use map teleporting, adjust the game rules and so on, whenever you see fit."
				""
				"{ \"text\": \"Most importantly, GregTech has some very complex recipes, so you need to be comfortable with JEI first.\",  \"italic\":\"true\",\"underlined\": \"true\", \"clickEvent\": { \"action\": \"change_page\", \"value\": \"575A2A1E4F56FF34\" } }"
			]
			hide_dependent_lines: true
			icon: "minecraft:command_block_minecart"
