		{
			description: [
				"A GregTech modpack focused on casual play (casual meaning lower difficulty than other GregTech packs)"
				""
				"Main Progression"
				"Steam &8ULV&r: gather basic resources, bigger and stronger steam machines, steel smelting, Dimensionally Transcendent Dirt Forge."
				"Low Voltage &7LV&r: basic electric machines, Electric Blast Furnace."
				"Medium Voltage &bMV&r: silicon crystals, oil processing, machine upgrades."
				"High Voltage &6HV&r: processors, Large Chemical Reactor, Tier 1 rocket to the Moon, Distillation Tower, titanium."
				"Extreme Voltage &5EV&r: Nano Processor, Void Miner, Tier 2/3/4 rockets, tungsten, platinum group metals."
				"Insane Voltage &9IV&r: Quantum Processor, Alloy Blast Smelter, Fission Reactor, Tier 5 rocket, large machines, Assembly Line, Data Bank."
				"Ludicrous Voltage &dLuV&r: Crystal Processor, Naquadah, Tier 6 rocket, Fusion Reactor MK1, computers."
				"ZPM Voltage &cZPM&r: Wetware Processor, Fusion Reactor MK2, Tier 7 rocket."
				"Ultimate Voltage &3UV&r: Bioware Processor, Fusion Reactor MK3, Deep Chemical Distorter, Circuit Assembly Line, Space Elevator."
				"Ultra High Voltage &4UHV&r: Optical Processor, Fusion Reactor MK4, Stellar Forge, Naquadria Bomb, Hyper Reactor."
				"Ultra Excessive Voltage &aUEV&r: Exotic Processor, Fusion Reactor MK5, Supercritical Crafting, bedrock processing, Adamantine."
				"Ultra Immense Voltage &2UIV&r: Cosmic Processor, Cosmic Probe, Mass Fabricator, quarks, superheavy elements."
				"Ultra Extreme Voltage &eUXV&r: Suprachronal Processor, Draconium, Cosmic Neutronium, Infinity, Dimensionally Transcendent Plasma Forge, Radox."
				"Overpowered Voltage &1OpV&r: Transcendent Circuits, Cosmos Simulation, Spacetime, Singularity, Eternity."
				"Maximum Voltage &cMAX&r: crafting creative items."
				"Bonus Question &cM&r&aA&r&9X&r&e+&r: Fishbig."
			]
			hide_dependent_lines: true
